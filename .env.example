# Server Configuration
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/dn-ecommerce
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/dn-ecommerce

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key
JWT_REFRESH_EXPIRE=30d

# PayOS Configuration
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
# Skip webhook signature verification (ONLY for development/testing)
PAYOS_SKIP_SIGNATURE=false
# IMPORTANT: Update these URLs to match your Test-Payment-PayOS frontend
# For local testing with http-server on port 8080
PAYOS_RETURN_URL=http://localhost:8080/payment-success.html
PAYOS_CANCEL_URL=http://localhost:8080/payment-success.html?cancel=true

# Email Configuration (Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_FROM=DN-Ecommerce <noreply@dn-ecommerce.com>

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Wallet Configuration
DEFAULT_CURRENCY=VND

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,image/webp

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=dn-ecommerce-products

# i18n
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,vi
